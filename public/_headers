# Netlify and Cloudflare Pages read this file. Everything in /assets/ has a
# content hash in its name, so it can be cached for a year; pages themselves
# are revalidated on every visit so a new deploy shows up at once.
/assets/*
  Cache-Control: public, max-age=31536000, immutable

/*
  Cache-Control: public, max-age=0, must-revalidate
